{
    "name": "portal3/portal",
    "description": "پورتال مشتریان - ابزار اکسل با PhpSpreadsheet",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "phpoffice/phpspreadsheet": "^1.29",
        "ext-zip": "*",
        "ext-xml": "*",
        "ext-mbstring": "*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^2.1"
    },
    "scripts": {
        "test": "phpunit --configuration phpunit.xml",
        "lint": "find . -path './vendor' -prune -o -name '*.php' -print0 | xargs -0 -n1 php -l",
        "analyse": "phpstan analyse --configuration=phpstan.neon"
    }
}
