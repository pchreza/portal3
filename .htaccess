# --- بهینه‌سازی تحویل فایل‌های استاتیک + امنیت پایه (Apache/Laragon) ---
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType image/x-icon "access plus 30 days"
    ExpiresByType font/woff2 "access plus 30 days"
</IfModule>
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# فایل‌های پیکربندی، credential و ابزار توسعه نباید از وب قابل دریافت باشند.
<FilesMatch "^(?:db_config\.php|\.env(?:\..*)?|composer\.(?:json|lock)|phpunit\.xml|phpstan\.neon|VERSION)$">
    Require all denied
</FilesMatch>
Options -Indexes
